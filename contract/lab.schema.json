{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enrichedlab.org/contract/2026-11/lab.schema.json",
  "title": "Lab descriptor: GET /.well-known/enrichedlab-lab",
  "type": "object",
  "required": ["contract", "name", "title", "endpoints", "sign_in"],
  "properties": {
    "contract": { "type": "string", "pattern": "^\\d{4}-\\d{2}(\\.\\d+)?$" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "endpoints": {
      "type": "object",
      "properties": {
        "models": { "type": "boolean" }, "mcp": { "type": "boolean" }, "bundles": { "type": "boolean" },
        "events": { "type": "boolean" }, "guard": { "type": "boolean" }, "devices": { "type": "boolean" },
        "containers": { "type": "boolean" }, "stop": { "type": "boolean" }, "ports": { "type": "boolean" },
        "attach": { "type": "boolean" }, "files": { "type": "boolean" }, "apps": { "type": "boolean" },
        "signers": { "type": "boolean" }, "usage": { "type": "boolean" }, "agents": { "type": "boolean" },
        "runs": { "type": "boolean" },
        "openapi": { "type": "boolean", "description": "GET /v1/openapi.json serves the API as OpenAPI 3.1" },
        "chat_completions": { "type": "boolean", "description": "POST /v1/chat/completions, OpenAI-compatible with stream, tools and reasoning_content; a descriptor that lists only models serves it too" },
        "checkpoints": { "type": "boolean", "description": "POST/GET /v1/containers/{id}/checkpoints and POST .../checkpoints/{cp}/restore: whole-filesystem snapshots of a sandbox (checkpoint.schema.json)" }
      }
    },
    "sign_in": { "type": "object", "required": ["kind"], "properties": { "kind": { "type": "string", "enum": ["cloudflare-access-oauth", "oauth"] } } },
    "policy": {
      "type": "object",
      "properties": {
        "keep_data_inside": { "type": "boolean" }, "device_proof": { "enum": ["off", "optional", "required"] },
        "sandbox_agents": { "enum": ["lab", "any"], "description": "whose agents use sandboxes by default: lab = only this lab's models; any = a person's own agents too" }
      }
    },
    "sandbox_desktop": {
      "type": "object",
      "required": ["image", "actions"],
      "description": "a desktop sandbox; POST /v1/containers/{id}/desktop takes one action (desktop.schema.json)",
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "screen": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
        "actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "open": { "type": "boolean", "description": "POST /v1/containers/{id}/desktop/open is served" },
        "open_targets": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "the kinds of target open takes, such as https and sandbox" },
        "max_type_chars": { "type": "integer", "minimum": 1, "description": "the most one type action takes" },
        "max_wait_seconds": { "type": "integer", "minimum": 0, "description": "the longest wait action" },
        "labels": { "type": "array", "items": { "enum": ["agent", "person"] }, "description": "the by labels the lab records" },
        "os": { "enum": ["linux", "macos"], "description": "linux when absent" },
        "title": { "type": "string" },
        "apps": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string" } } }, "description": "what launch starts" },
        "open_with": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "apps open takes in with" },
        "stream": { "type": "boolean", "description": "GET /v1/containers/{id}/desktop/stream serves a live view, subprotocol gate.desktop.v1" }
      }
    },
    "sandbox_desktops": { "type": "array", "items": { "type": "object", "required": ["image", "actions"], "properties": { "image": { "type": "string", "minLength": 1 }, "os": { "enum": ["linux", "macos"] }, "actions": { "type": "array", "items": { "type": "string", "minLength": 1 } } } }, "description": "every desktop the lab offers, each shaped like sandbox_desktop, which repeats the first" },
    "support": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "pattern": "^https://" } } },
    "docs": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "pattern": "^https://" } } },
    "sandbox_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "cpu", "memory"],
        "properties": {
          "name": { "type": "string" }, "cpu": { "type": "number", "minimum": 0 }, "memory": { "type": "string" },
          "gpu": { "type": "string" }, "wall_minutes": { "type": "integer", "minimum": 1 }, "runtime_class": { "type": "string" }
        }
      }
    },
    "browser": {
      "type": "object",
      "required": ["protocol", "port"],
      "properties": {
        "protocol": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1 },
        "version": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "sandbox_networks": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 }, "title": { "type": "string" }, "description": { "type": "string" } } }
    },
    "sandbox_images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }, "title": { "type": "string" }, "description": { "type": "string" },
          "browser": {
            "type": "object",
            "required": ["protocol", "port"],
            "properties": { "protocol": { "type": "string" }, "port": { "type": "integer", "minimum": 1 }, "version": { "type": "string" } }
          }
        }
      }
    },
    "packages": {
      "type": "object",
      "description": "Package sources the lab vets and scans; clients point sandbox and local environments at these instead of public ones",
      "properties": {
        "conda": { "type": "array", "items": { "type": "string", "format": "uri" }, "description": "conda channels, in priority order (pixi, conda, mamba)" },
        "pypi": { "type": "string", "format": "uri", "description": "a PEP 503 or PEP 691 simple index" },
        "cran": { "type": "string", "format": "uri", "description": "a CRAN-like R repository" },
        "npm": { "type": "string", "format": "uri", "description": "an npm registry" },
        "only": { "type": "boolean", "description": "true when the lab's sandboxes reach these and no public package source" }
      }
    },
    "conformance": {
      "type": "object",
      "properties": {
        "foreign_scope": { "type": "string" },
        "scan_test": { "type": "boolean" },
        "data_tool": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "arguments": { "type": "object" } } }
      }
    }
  }
}
