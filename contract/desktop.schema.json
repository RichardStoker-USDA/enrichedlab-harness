{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enrichedlab.org/contract/2026-11/desktop.schema.json",
  "title": "Desktop sandbox: POST /v1/containers/{id}/desktop and its answer",
  "$defs": {
    "point": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }], "minItems": 2, "maxItems": 2 },
    "action": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "enum": [
            "screenshot", "cursor_position", "mouse_move", "left_click", "right_click", "middle_click", "double_click",
            "triple_click", "left_click_drag", "type", "key", "scroll", "zoom", "wait", "state", "focus_window", "launch"
          ]
        },
        "window": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$", "description": "focus_window: a window id from state" },
        "app": { "type": "string", "minLength": 1, "description": "launch: an app id from the descriptor's apps" },
        "coordinate": { "$ref": "#/$defs/point" },
        "start_coordinate": { "$ref": "#/$defs/point" },
        "text": { "type": "string", "maxLength": 4000, "description": "type: the text; key: an xdotool-style key or chord such as ctrl+s" },
        "scroll_direction": { "enum": ["up", "down", "left", "right"] },
        "scroll_amount": { "type": "integer", "minimum": 1, "maximum": 50 },
        "region": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 4, "maxItems": 4, "description": "zoom: x0, y0, x1, y1" },
        "duration": { "type": "number", "minimum": 0, "maximum": 30, "description": "wait: seconds" },
        "by": { "enum": ["agent", "person"], "description": "who the client says asked; a label beside the audited actor, never authority" }
      }
    },
    "answer": {
      "type": "object",
      "required": ["ok", "action"],
      "description": "screenshot comes only after screenshot and zoom (its size is the PNG's own, so a zoom answers the zoomed size); cursor only after cursor_position. A client that wants to see the result of input asks for a screenshot after it",
      "properties": {
        "ok": { "type": "boolean" },
        "action": { "type": "string" },
        "screenshot": { "type": "object", "required": ["png", "width", "height"], "properties": { "png": { "type": "string", "description": "base64 PNG" }, "width": { "type": "integer" }, "height": { "type": "integer" } } },
        "cursor": { "$ref": "#/$defs/point" },
        "state": { "$ref": "#/$defs/state" },
        "window": { "$ref": "#/$defs/window", "description": "after launch (when a window appeared) or focus_window" }
      }
    },
    "bounds": { "type": "object", "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" } } },
    "window": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string" }, "app": { "type": "string" }, "title": { "type": "string" }, "bounds": { "$ref": "#/$defs/bounds" }, "focused": { "type": "boolean" }, "minimized": { "type": "boolean" } }
    },
    "state": {
      "type": "object",
      "required": ["screen", "windows"],
      "description": "the answer to state: the windows, and the focused window's accessibility tree (role, name, value, states, bounds, children per node)",
      "properties": {
        "screen": { "type": "object", "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } } },
        "cursor": { "$ref": "#/$defs/point" },
        "windows": { "type": "array", "items": { "$ref": "#/$defs/window" } },
        "focused": { "type": "object", "properties": { "window": { "type": "string" }, "tree": { "type": "object" }, "nodes": { "type": "integer" }, "truncated": { "type": "boolean" } } }
      }
    },
    "open": { "type": "object", "required": ["target"], "properties": { "target": { "type": "string", "description": "an http(s) address with a host and no user or password, or a path under /sandbox/ with no . or .. segments" }, "with": { "type": "string", "description": "an app from the descriptor's open_with; the browser when absent" }, "by": { "enum": ["agent", "person"] } } },
    "opened": { "type": "object", "required": ["opened"], "properties": { "opened": { "type": "string" } } }
  },
  "$ref": "#/$defs/action"
}
